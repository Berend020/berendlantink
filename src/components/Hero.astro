---
import { profile } from '../data/profile';
import LinkedInButton from './LinkedInButton.astro';
---
<section class="hero container" aria-labelledby="hero-title"><div class="hero-copy"><h1 id="hero-title">Payments<br/>professional<span class="accent">{profile.experience}</span></h1><p class="intro">{profile.intro}</p><ul class="highlights">{profile.highlights.map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul><LinkedInButton /></div><div class="hero-art"><svg viewBox="0 0 560 560" role="img" aria-labelledby="card-title"><title id="card-title">Minimalistische illustratie van een contactloze betaalkaart</title><defs><linearGradient id="wash" x2="1" y2="1"><stop stop-color="#f6f3ff"/><stop offset="1" stop-color="#e8e1fa"/></linearGradient><linearGradient id="card" x2="1" y2="1"><stop stop-color="#ffffff"/><stop offset="1" stop-color="#f0eafb"/></linearGradient><filter id="shadow" x="-50%" y="-50%" width="200%" height="220%"><feDropShadow dx="0" dy="23" stdDeviation="19" flood-color="#62508c" flood-opacity=".13"/></filter></defs><path d="M82 167C107 76 246 49 355 94S523 220 493 344 366 486 236 467 43 315 82 167" fill="url(#wash)"/><circle cx="441" cy="113" r="7" fill="#d6c9f3"/><circle cx="91" cy="393" r="5" fill="#b9a0e3"/><path d="M444 412h20m-10-10v20" stroke="#b9a0e3" stroke-width="2"/><g transform="rotate(-12 280 280)" filter="url(#shadow)"><rect x="100" y="161" width="365" height="232" rx="23" fill="url(#card)" stroke="#8a65c5" stroke-width="2"/><rect x="129" y="194" width="46" height="35" rx="8" fill="#e9dff8" stroke="#a88acb"/><path d="M144 194v35m16-35v35m-31-17h46" stroke="#b194d1"/><g fill="none" stroke="#855eb7" stroke-width="3" stroke-linecap="round"><path d="M414 199q19 17 0 34m-8-28q12 11 0 22m-8-16q5 5 0 10"/></g><path d="M130 293h38m16 0h38m16 0h38m16 0h38" stroke="#bea7dd" stroke-width="5" stroke-linecap="round"/><path d="M130 345h102m-102 13h63" stroke="#cfbee7" stroke-width="4" stroke-linecap="round"/><circle cx="405" cy="347" r="18" fill="#b191db" fill-opacity=".65"/><circle cx="426" cy="347" r="18" fill="#dfd0f1" fill-opacity=".8"/></g><path d="M139 437q140 49 282-14" fill="none" stroke="#d7c9eb" stroke-dasharray="3 7" stroke-linecap="round"/></svg><p>Techniek. Processen. Commercie.</p></div></section>
